model GroupInvite {
  id             String            @id @default(cuid())
  conversationId String            @map("conversation_id")
  senderId       String            @map("sender_id")
  receiverId     String            @map("receiver_id")
  status         GroupInviteStatus @default(PENDING)
  expiresAt      DateTime?         @map("expires_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("GroupInviteSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User         @relation("GroupInviteReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([conversationId, receiverId])
  @@map("group_invites")
}

// Enums
enum FriendRequestStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  MEMBER
  ADMIN
  OWNER
}

enum DeliveryStatus {
  SENT
  DELIVERED
  READ
}

enum GroupInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}